# ============================================================================
#  .env.example —— 环境变量模板
#
#  【这个文件放什么】只放**字段名**和说明，**绝不放真实值**。
#  【怎么用】复制一份改成 .env，在 .env 里填真实值：
#        cp .env.example .env      （Windows 用 copy .env.example .env）
#     .env 已被 .gitignore 忽略（git check-ignore .env 可验证），不会进仓库。
#
#  ⚠️ 为什么要分两个文件：
#     .env          放真值 → 只存在于你自己的机器 → 永远不提交
#     .env.example  放字段名 → 进仓库 → 别人照着就知道要配哪些
#
#  本文件里的每一项都对应代码里真实读取的位置（不是凭空列的）。
#  代码读取处见每项的「代码在哪读」注释。
# ============================================================================


# ---------------------------------------------------------------------------
# 一、必填：数据库访问
# ---------------------------------------------------------------------------

# 数据库 API Key（后端专用，对应 service_role）
#   代码在哪读：repositories/dbClient.js → process.env.CLOUDBASE_API_KEY
#   怎么配（Day 23 实测确认：本环境控制台没有「API Key 设置」开关）：
#     方式 A：控制台 → 环境管理 → API Key 配置 →「服务端 API Key」→ 创建，
#             然后在云函数的「环境变量」里加一条 CLOUDBASE_APIKEY = 那串值
#     方式 B：在云函数「环境变量」里直接加 CLOUDBASE_API_KEY = 那串值
#   代码两个名字都读（dbClient.js 第 33 行），任一存在即可
#   ⚠️ 这是本项目最敏感的凭证。泄露它 = 任何人都能读写你的数据库。
#   ⚠️ 绝不要把它写进任何代码文件、注释、截图、聊天记录里。
CLOUDBASE_API_KEY=

# 环境 ID（CloudBase 环境标识，形如 my-first-project-xxxxxxxx）
#   代码在哪读：repositories/dbClient.js → process.env.CLOUDBASE_ENV
#   留空则用代码里的默认值；换环境时才需要改。
#   注意：这个不算机密（本来就在公网域名里），但保持配置统一更好排查。
CLOUDBASE_ENV=


# ---------------------------------------------------------------------------
# 二、按函数分别配置（重要：三个云函数配不同的值）
#
#   本项目是「一路由一函数」架构：api / categories / courses 三个函数共用同一份代码，
#   靠 API_ROUTE 变量告诉它"你负责哪条路由"。
# ---------------------------------------------------------------------------

# 这个函数负责哪条路由。可选值：health / categories / courses
#   代码在哪读：index.js → process.env.API_ROUTE
#   三个函数分别配：api→health、categories→categories、courses→courses
#   ⚠️ 本环境的 HTTP 网关不转发请求路径，所以必须靠这个变量自报身份。
API_ROUTE=


# ---------------------------------------------------------------------------
# 三、跨域（CORS）
# ---------------------------------------------------------------------------

# 允许哪些来源跨域访问，逗号分隔多个。**禁止用 * 通配符**。
#   代码在哪读：index.js → process.env.CORS_ALLOWED_ORIGIN
#   留空则回退到代码里的默认域名（静态托管的默认域名）。
#   ⚠️ 写 * 等于把数据库敞开给任何网站，别图省事。
CORS_ALLOWED_ORIGIN=


# ---------------------------------------------------------------------------
# 四、可选：调试与限流（不配就用代码里的默认值）
# ---------------------------------------------------------------------------

# 设为 1 时，函数会把收到的网关事件原样回显（脱敏后），用于排查"网关到底传了什么"
#   代码在哪读：index.js → process.env.DEBUG_EVENT
#   ⚠️ 排查完记得删掉或改回 0。它会回显 header 名，有一定信息暴露面。
DEBUG_EVENT=

# 写接口限流：单 IP 每分钟最多几次（仅 POST / PATCH / DELETE，读接口不限）
#   代码在哪读：services/rateLimiter.js → process.env.RATE_LIMIT_PER_MIN
#   留空 = 20 次/分。**一般不要改**，改大了等于关掉这层保护。
RATE_LIMIT_PER_MIN=


# ---------------------------------------------------------------------------
# 五、通常不需要动的（本地测试用）
# ---------------------------------------------------------------------------

# 覆盖数据库 REST 网关地址（本地起假网关测试时才需要）
#   代码在哪读：repositories/dbClient.js → process.env.CLOUDBASE_RDB_BASE
#   线上永远不要设。
CLOUDBASE_RDB_BASE=


# ============================================================================
#  安全自查（配置完顺手核一遍）
#
#   ① git status 里看不到 .env        → 因为被 .gitignore 忽略了
#   ② git check-ignore .env           → 输出 .env 即为已忽略
#   ③ git ls-files | grep '\.env$'    → 应为空（仓库里只有 .env.example）
#   ④ 代码里搜 API_KEY= 后面跟真实值  → 应 0 命中
#
#  ⚠️ 万一密钥真的进了 Git 历史：**立刻到平台控制台作废并重新生成**，
#     光删代码不够——历史里还能翻出来。作废后更新这里的 .env 即可。
# ============================================================================
